<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon ?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="de.srh_dr.mediamanagementtoolmmt.controller.MediaSearchDialogController"
           prefWidth="500" prefHeight="400">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox fx:id="layerSelection" alignment="CENTER" spacing="40">
        <Label text="%ui.selectApiSource" styleClass="section-header"/>

        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="15" styleClass="api-tile" onMouseClicked="#handleSelectGoogleBooks">
                <FontIcon iconLiteral="fas-book" iconSize="64" styleClass="tile-icon"/>
                <Label wrapText="true" maxWidth="Infinity" alignment="CENTER" text="Google Books" styleClass="tile-label"/>
            </VBox>

            <VBox alignment="CENTER" spacing="15" styleClass="api-tile" onMouseClicked="#handleSelectTMDB">
                <FontIcon iconLiteral="fas-film" iconSize="64" styleClass="tile-icon"/>
                <Label wrapText="true" maxWidth="Infinity" alignment="CENTER" text="The Movie Database" styleClass="tile-label"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="layerLoading" alignment="CENTER" spacing="15" visible="false" managed="false">
        <ProgressIndicator />
        <Label fx:id="loadingLabel" text="%ui.searching"/>
    </VBox>

    <VBox fx:id="layerResults" spacing="10" visible="false" managed="false">
        <Label fx:id="resultsLabel" text="%ui.selectResult" styleClass="section-header"/>
        <ListView fx:id="resultsListView" VBox.vgrow="ALWAYS"/>

        <HBox alignment="BOTTOM_RIGHT" spacing="10">
            <Button text="%ui.cancel" onAction="#handleCancel"/>
            <Button fx:id="importButton" text="%ui.import" onAction="#handleImport" disable="true"/>
        </HBox>
    </VBox>

</StackPane>
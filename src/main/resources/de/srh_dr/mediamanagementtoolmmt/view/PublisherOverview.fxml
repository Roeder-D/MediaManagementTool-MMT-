<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>

<VBox prefHeight="600" prefWidth="800" styleClass="view-container" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.srh_dr.mediamanagementtoolmmt.controller.PublisherOverviewController">
    <HBox styleClass="controls-bar" spacing="15.0" alignment="CENTER_LEFT">
        <Label styleClass="control-label" text="%ui.search"/>
        <TextField fx:id="searchField" prefWidth="250" promptText="%ui.search_publisher" styleClass="search-field"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <ListView fx:id="publisherList" VBox.vgrow="ALWAYS">
    </ListView>
</VBox>
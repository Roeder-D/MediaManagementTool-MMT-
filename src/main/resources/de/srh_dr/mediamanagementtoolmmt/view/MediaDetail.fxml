<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="viewContainer" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.srh_dr.mediamanagementtoolmmt.controller.MediaDetailController" stylesheets="@../css/style.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <top>
        <HBox alignment="TOP_RIGHT" spacing="15.0" BorderPane.alignment="CENTER">
            <Button text="%ui.lend" onAction="#handleLendMedia"/>
            <Button text="%ui.edit" onAction="#handleEditMedia"/>
            <Button text="%ui.delete" onAction="#handleDeleteMedia"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="30.0" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="20.0" />
            </BorderPane.margin>

            <HBox spacing="40.0">
                <VBox alignment="TOP_CENTER" spacing="15.0" minWidth="-Infinity">
                    <ImageView fitHeight="250.0" fitWidth="180.0" preserveRatio="true" styleClass="cover-image" />

                    <HBox alignment="CENTER" spacing="10.0">
                        <Label text="%ui.rating" styleClass="field-label"/>
                        <HBox fx:id="ratingBox" alignment="CENTER" spacing="2" styleClass="rating-box"/>
                    </HBox>
                </VBox>

                <GridPane hgap="20.0" vgap="12.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="%ui.title" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="titleLabel" styleClass="media-title" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label fx:id="isbnLabel" text="%ui.isbn" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="isbnField" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="%ui.series" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="seriesField" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label fx:id="seriesOrderField" prefWidth="60.0" GridPane.rowIndex="2"/>

                    <Label text="%ui.franchise" styleClass="field-label" GridPane.valignment="TOP" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <FlowPane fx:id="franchiseContainer" hgap="6" vgap="6" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="%ui.artist" styleClass="field-label" GridPane.valignment="TOP" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <VBox fx:id="artistContainer" spacing="8" styleClass="credits-list-box" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="%ui.publisher" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <Label fx:id="publisherField" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label text="%ui.releasedate" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <Label fx:id="releaseDateField" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                    <Label text="%ui.genre" styleClass="field-label" GridPane.valignment="TOP" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <FlowPane fx:id="genreContainer" hgap="6" vgap="6" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                    <Label text="%ui.tags" styleClass="field-label" GridPane.valignment="TOP" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <FlowPane fx:id="tagsContainer" hgap="6" vgap="6" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                </GridPane>
            </HBox>

            <VBox spacing="10.0">
                <Label text="%ui.description" styleClass="section-header" />
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <Label fx:id="descriptionField" text="No description available." wrapText="true" />
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600" prefWidth="800" styleClass="view-container" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.srh_dr.mediamanagementtoolmmt.controller.LendingOverviewController">
    <children>
        <HBox styleClass="controls-bar" spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <Label styleClass="control-label" text="%ui.search" />
                <TextField fx:id="searchField" prefWidth="250" promptText="%ui.search_lending" styleClass="search-field"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label styleClass="control-label" text="%ui.label.sort_by"/>
                <ComboBox fx:id="statusFilterComboBox" prefWidth="150" promptText="Status Filter"/>
            </children>
        </HBox>
        <TableView fx:id="lendingTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="titleCol" prefWidth="250" text="%ui.title"/>
                <TableColumn fx:id="lendeeCol" prefWidth="200" text="%ui.lendee"/>
                <TableColumn fx:id="borrowedCol" prefWidth="120" text="%ui.lent_on"/>
                <TableColumn fx:id="returnedCol" prefWidth="120" text="%ui.returned_on"/>
                <TableColumn fx:id="statusCol" prefWidth="100" text="%ui.status"/>
            </columns>
        </TableView>
    </children>
</VBox>

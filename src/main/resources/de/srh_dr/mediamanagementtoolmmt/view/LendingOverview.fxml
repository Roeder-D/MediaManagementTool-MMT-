<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600" prefWidth="800" styleClass="view-container" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.srh_dr.mediamanagementtoolmmt.controller.LendingOverviewController">
    <HBox styleClass="controls-bar" spacing="15.0" alignment="CENTER_LEFT">
        <Label styleClass="control-label" text="%ui.search"/>
        <TextField fx:id="searchField" prefWidth="250" promptText="%ui.search_lending" styleClass="search-field"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label styleClass="control-label" text="%ui.label.filter_by"/>
        <ComboBox fx:id="statusFilterComboBox" prefWidth="150" promptText="Status Filter"/>
    </HBox>
    <TableView fx:id="lendingTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="titleCol" prefWidth="250" text="%ui.title" styleClass="left-aligned-column"/>
            <TableColumn fx:id="lendeeCol" prefWidth="200" text="%ui.lendee" styleClass="left-aligned-column"/>
            <TableColumn fx:id="borrowedCol" prefWidth="120" text="%ui.lent_on" styleClass="centered-column"/>
            <TableColumn fx:id="returnedCol" prefWidth="120" text="%ui.returned_on" styleClass="centered-column"/>
            <TableColumn fx:id="statusCol" prefWidth="100" text="%ui.status" styleClass="right-aligned-column"/>
        </columns>
    </TableView>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import org.controlsfx.control.Rating?>
<?import org.controlsfx.control.SearchableComboBox?>
<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.srh_dr.mediamanagementtoolmmt.controller.MediaFormController">
    <BorderPane>
        <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
        </padding>

        <center>
            <VBox spacing="30">
                <HBox spacing="30">
                    <VBox alignment="TOP_CENTER" spacing="15">
                        <StackPane fx:id="imageDropZone" onDragOver="#handleDragOver" onDragDropped="#handleDrop" styleClass="drop-zone" prefHeight="250" prefWidth="180">
                            <ImageView fx:id="coverImage" fitHeight="250" fitWidth="180" preserveRatio="true" styleClass="cover-image"/>
                        </StackPane>
                        <Button text="%ui.uploadImage" onAction="#handleImageUpload"/>
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="%ui.rating" styleClass="field-label"/>
                            <Rating fx:id="mediaRating" max="5" rating="0"/>
                        </HBox>
                    </VBox>

                    <GridPane hgap="20" vgap="12" HBox.hgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label fx:id="isbnLabel" text="%ui.isbn" styleClass="field-label" GridPane.rowIndex="0"/>
                        <TextField fx:id="isbnField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="%ui.title" styleClass="field-label" GridPane.rowIndex="1"/>
                        <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="%ui.originalTitle" styleClass="field-label" GridPane.rowIndex="2"/>
                        <TextField fx:id="originalTitleField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="%ui.releasedate" styleClass="field-label" GridPane.rowIndex="3"/>
                        <DatePicker fx:id="releaseDateField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="%ui.mediaType" styleClass="field-label" GridPane.rowIndex="4"/>
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <SearchableComboBox fx:id="mediaTypeComboBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="+" onAction="#handleAddNewMediaType"/>
                        </HBox>

                        <Label text="%ui.publisher" styleClass="field-label" GridPane.rowIndex="5"/>
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="5">
                            <SearchableComboBox fx:id="publisherComboBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="+" onAction="#handleAddNewPublisher"/>
                        </HBox>

                        <Label text="%ui.series" styleClass="field-label" GridPane.rowIndex="6"/>
                        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="6">
                            <SearchableComboBox fx:id="seriesComboBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="+" onAction="#handleAddNewSeries"/>
                        </HBox>

                        <Label text="%ui.genre" styleClass="field-label" GridPane.rowIndex="7" GridPane.valignment="TOP"/>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="7">
                            <VBox fx:id="genreContainer" spacing="5"/>
                            <Button text="%ui.addGenre" onAction="#addGenreDropdown"/>
                        </VBox>

                        <Label text="%ui.language" styleClass="field-label" GridPane.rowIndex="8" GridPane.valignment="TOP"/>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="8">
                            <VBox fx:id="languageContainer" spacing="5"/>
                            <Button text="%ui.addLanguage" onAction="#addLanguageRow"/>
                        </VBox>

                        <Label text="%ui.artist" styleClass="field-label" GridPane.rowIndex="9" GridPane.valignment="TOP"/>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="9">
                            <VBox fx:id="artistContainer" spacing="5"/>
                            <Button text="%ui.addArtist" onAction="#addArtistDropRow"/>
                        </VBox>
                    </GridPane>
                </HBox>

                <VBox spacing="10">
                    <Label text="%ui.description" styleClass="section-header"/>
                    <TextArea fx:id="descriptionArea" wrapText="true"/>
                </VBox>

                <HBox alignment="BOTTOM_RIGHT" spacing="15">
                    <Button text="%ui.abort" onAction="#handleCancel"/>
                    <Button text="%ui.submit" onAction="#handleSubmit"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

</ScrollPane>